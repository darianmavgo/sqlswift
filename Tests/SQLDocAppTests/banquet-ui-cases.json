{
  "_doc": "Banquet URL UI cases. Shared by the headless Swift Testing suite (BanquetUITests.swift) and the live-app runner (scripts/ui-e2e.py). {DB} is the fixture database path. steps use the dev command vocabulary from UICommands.swift; `type` needs the real SwiftUI field so those cases set ui=true and run only in the live runner. expect is checked after the last step against uiStateSnapshot().",
  "cases": [
    { "name": "plain table (no slice = all rows)", "steps": ["url {DB}/telemetry"],
      "expect": { "table": "telemetry", "url": "{DB}/telemetry", "sort": "", "filters": 0, "offset": 0, "pageLimit": 50000, "rowsLoaded": 10000, "visibleColumns": ["id","device_id","timestamp","temperature","humidity","pressure","raw_payload"] } },
    { "name": "sort descending", "steps": ["url {DB}/telemetry/-id[0:100]"],
      "expect": { "url": "{DB}/telemetry/-id[0:100]", "sort": "id desc", "rowsLoaded": 100 } },
    { "name": "slice notation", "steps": ["url {DB}/telemetry/+temperature[200:250]"],
      "expect": { "url": "{DB}/telemetry/+temperature[200:250]", "sort": "temperature asc", "offset": 200, "pageLimit": 50, "rowsLoaded": 50 } },
    { "name": "sort marker keeps its column in the projection", "steps": ["url {DB}/telemetry/id,+temperature,humidity[0:100]"],
      "expect": { "url": "{DB}/telemetry/id,+temperature,humidity[0:100]", "sort": "temperature asc", "visibleColumns": ["id","temperature","humidity"] } },
    { "name": "sort marker alone is sort-only", "steps": ["url {DB}/telemetry/-id"],
      "expect": { "sort": "id desc", "visibleColumns": ["id","device_id","timestamp","temperature","humidity","pressure","raw_payload"] } },
    { "name": "sorting by a projected-out column uses ?sort=", "steps": ["url {DB}/telemetry/id,humidity[0:100]?sort=temperature&order=desc"],
      "expect": { "url": "{DB}/telemetry/id,humidity[0:100]?sort=temperature&order=desc", "sort": "temperature desc", "visibleColumns": ["id","humidity"] } },
    { "name": "where= param", "steps": ["url {DB}/telemetry[0:100]?where=id>6000"],
      "expect": { "url": "{DB}/telemetry[0:100]?where=id > 6000", "filters": 1, "rowsLoaded": 100 } },
    { "name": "bare ?col>value defaults to where", "steps": ["url {DB}/telemetry[0:100]?id>6000"],
      "expect": { "url": "{DB}/telemetry[0:100]?where=id > 6000", "filters": 1, "rowsLoaded": 100 } },
    { "name": "bare ?col=value defaults to where", "steps": ["url {DB}/telemetry[0:100]?device_id=3"],
      "expect": { "filters": 1, "rowsLoaded": 100 } },
    { "name": "two bare params are ANDed", "steps": ["url {DB}/telemetry[0:100]?device_id=3&id>6000"],
      "expect": { "filters": 2, "rowsLoaded": 100 } },
    { "name": "regression: +id>6000 in path must not become a column", "steps": ["url {DB}/telemetry/+id>6000,temperature,humidity[0:100]"],
      "expect": { "url": "{DB}/telemetry/+id,temperature,humidity[0:100]?where=id > 6000", "sort": "id asc", "filters": 1, "rowsLoaded": 100, "visibleColumns": ["id","temperature","humidity"] } },
    { "name": "limit via query param", "steps": ["url {DB}/telemetry?limit=25"],
      "expect": { "pageLimit": 25, "rowsLoaded": 25 } },

    { "name": "grid: sort then bar", "steps": ["url {DB}/telemetry[0:100]","sort id desc"],
      "expect": { "url": "{DB}/telemetry/-id[0:100]", "sort": "id desc" } },
    { "name": "grid: page next", "steps": ["url {DB}/telemetry/-id[0:100]","page next"],
      "expect": { "url": "{DB}/telemetry/-id[100:200]", "offset": 100 } },
    { "name": "grid: page size", "steps": ["url {DB}/telemetry","size 25"],
      "expect": { "url": "{DB}/telemetry[0:25]", "pageLimit": 25, "rowsLoaded": 25 } },
    { "name": "grid: filter then clear", "steps": ["url {DB}/telemetry[0:100]","filter id greater 50","clearfilters"],
      "expect": { "url": "{DB}/telemetry[0:100]", "filters": 0 } },
    { "name": "grid: filter shows in bar", "steps": ["url {DB}/telemetry[0:100]","filter id greater 50"],
      "expect": { "url": "{DB}/telemetry[0:100]?where=id > 50", "filters": 1 } },
    { "name": "grid: hiding a column projects the rest", "steps": ["url {DB}/telemetry[0:100]","hide timestamp","hide pressure","hide raw_payload"],
      "expect": { "url": "{DB}/telemetry/id,device_id,temperature,humidity[0:100]", "visibleColumns": ["id","device_id","temperature","humidity"] } },
    { "name": "grid: hiding the sorted column moves sort to ?sort=", "steps": ["url {DB}/telemetry/+temperature","hide timestamp","hide pressure","hide raw_payload","hide temperature"],
      "expect": { "sort": "temperature asc" } },
    { "name": "grid: show all restores full select", "steps": ["url {DB}/telemetry[0:100]","hide id","showall"],
      "expect": { "url": "{DB}/telemetry[0:100]" } },

    { "name": "bar: typed edit live-applies", "ui": true, "steps": ["url {DB}/telemetry","type {DB}/telemetry/+temperature[200:250]"],
      "expect": { "bar": "{DB}/telemetry/+temperature[200:250]", "url": "{DB}/telemetry/+temperature[200:250]", "sort": "temperature asc", "offset": 200, "pageLimit": 50 } },
    { "name": "bar: half-typed table name is ignored", "ui": true, "steps": ["url {DB}/telemetry","type {DB}/telem"],
      "expect": { "bar": "{DB}/telem", "url": "{DB}/telemetry" } },
    { "name": "bar: half-typed sort column is ignored", "ui": true, "steps": ["url {DB}/telemetry","type {DB}/telemetry/+tempe"],
      "expect": { "bar": "{DB}/telemetry/+tempe", "sort": "" } },
    { "name": "bar: blur reverts unapplied text to the grid URL", "ui": true, "steps": ["url {DB}/telemetry","type {DB}/telem","blur"],
      "expect": { "bar": "{DB}/telemetry" } },
    { "name": "bar: typed bare ?col>value applies and normalizes on blur", "ui": true, "steps": ["url {DB}/telemetry","type {DB}/telemetry[0:100]?id>6000","blur"],
      "expect": { "bar": "{DB}/telemetry[0:100]?where=id > 6000", "filters": 1 } },

    { "name": "omnibox: plain text suggests matching table first", "steps": ["url {DB}/telemetry","suggest tele"],
      "expect": { "suggestions": ["{DB}/telemetry"], "url": "{DB}/telemetry" } },
    { "name": "omnibox: column completion keeps the sort marker", "steps": ["url {DB}/telemetry","suggest {DB}/telemetry/-temp"],
      "expect": { "suggestions": ["{DB}/telemetry/-temperature"] } },
    { "name": "omnibox: @tables lists tables of the open doc", "steps": ["url {DB}/telemetry","suggest @tables tele"],
      "expect": { "suggestions": ["{DB}/telemetry"] } },
    { "name": "omnibox: @ alone offers the keywords", "steps": ["url {DB}/telemetry","suggest @"],
      "expect": { "suggestions": ["@tables ","@open ","@recent ","@history "] } },
    { "name": "omnibox: browsing suggestions never changes the grid", "steps": ["url {DB}/telemetry/-id","suggest tele","suggest @tables tele"],
      "expect": { "url": "{DB}/telemetry/-id", "sort": "id desc" } },

    { "name": "nav: back and forward restore URLs", "steps": ["url {DB}/telemetry","go {DB}/telemetry/-id","go {DB}/telemetry/+temperature[200:250]","back"],
      "expect": { "url": "{DB}/telemetry/-id", "sort": "id desc", "navBack": true, "navForward": true } },
    { "name": "nav: back to the start disables Back", "steps": ["url {DB}/telemetry","go {DB}/telemetry/-id","back"],
      "expect": { "url": "{DB}/telemetry", "navBack": false, "navForward": true } },
    { "name": "nav: a new visit after back drops forward history", "steps": ["url {DB}/telemetry","go {DB}/telemetry/-id","back","go {DB}/telemetry/+temperature"],
      "expect": { "sort": "temperature asc", "navBack": true, "navForward": false } },
    { "name": "nav: forward re-applies", "steps": ["url {DB}/telemetry","go {DB}/telemetry/-id","back","forward"],
      "expect": { "url": "{DB}/telemetry/-id", "navForward": false } },

    { "name": "omnibox: typing @tables in the real field opens the dropdown", "ui": true, "steps": ["url {DB}/telemetry","type @tables tele"],
      "expect": { "bar": "@tables tele", "suggestions": ["{DB}/telemetry"], "url": "{DB}/telemetry" } },
    { "name": "omnibox: blur closes the dropdown and reverts", "ui": true, "steps": ["url {DB}/telemetry","type @tables tele","blur"],
      "expect": { "bar": "{DB}/telemetry", "suggestions": [] } },

    { "name": "all rows: removing the slice and submitting shows every row", "steps": ["url {DB}/telemetry[0:100]","url {DB}/telemetry"],
      "expect": { "url": "{DB}/telemetry", "rowsLoaded": 10000, "offset": 0, "pageLimit": 50000 } },
    { "name": "all rows: an explicit slice is respected", "steps": ["url {DB}/telemetry","url {DB}/telemetry[0:100]"],
      "expect": { "url": "{DB}/telemetry[0:100]", "rowsLoaded": 100, "pageLimit": 100 } },
    { "name": "all rows: a slice beyond 1000 rows is honoured", "steps": ["url {DB}/telemetry[0:2500]"],
      "expect": { "url": "{DB}/telemetry[0:2500]", "rowsLoaded": 2500 } },
    { "name": "all rows: [0:] means the whole table", "steps": ["url {DB}/telemetry[0:]"],
      "expect": { "url": "{DB}/telemetry", "rowsLoaded": 10000 } },
    { "name": "all rows: [9990:] is a page starting at 9990, not all rows", "steps": ["url {DB}/telemetry[9990:]"],
      "expect": { "url": "{DB}/telemetry[9990:10090]", "offset": 9990, "rowsLoaded": 10 } },
    { "name": "all rows: sorting keeps every row and no slice", "steps": ["url {DB}/telemetry","sort id desc"],
      "expect": { "url": "{DB}/telemetry/-id", "sort": "id desc", "rowsLoaded": 10000 } },
    { "name": "all rows: page commands do nothing, there is one page", "steps": ["url {DB}/telemetry","page next","page last"],
      "expect": { "url": "{DB}/telemetry", "offset": 0, "rowsLoaded": 10000 } },
    { "name": "all rows: past the cap the bar shows the slice it really loaded", "steps": ["url {DB}/telemetry[0:100]","allrowscap 5000","url {DB}/telemetry"],
      "expect": { "url": "{DB}/telemetry[0:5000]", "rowsLoaded": 5000, "pageLimit": 5000 } },

    { "name": "bar: deleting the slice while typing waits for Return", "ui": true, "steps": ["url {DB}/telemetry[0:100]","type {DB}/telemetry"],
      "expect": { "bar": "{DB}/telemetry", "url": "{DB}/telemetry[0:100]", "rowsLoaded": 100 } }
  ]
}
